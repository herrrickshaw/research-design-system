{
 "$schema": "research-design-system/tokens@1",
 "version": "1.0.0",
 "groups": {
  "color": {
   "gray-0": "#f8f9fa",
   "gray-1": "#f1f3f5",
   "gray-2": "#e9ecef",
   "gray-3": "#dee2e6",
   "gray-4": "#ced4da",
   "gray-5": "#adb5bd",
   "gray-6": "#868e96",
   "gray-7": "#495057",
   "gray-8": "#343a40",
   "gray-9": "#212529",
   "teal-deep": "#1f5f5b",
   "teal-mid": "#58bdb5",
   "teal-dark": "#1d3634",
   "rust": "#a5402c",
   "coral": "#e0785f",
   "sage-2": "#d7dace",
   "sage-1": "#eef1ea",
   "warm-gray": "#82867a",
   "paper": "#fcfcfa",
   "paper-alt": "#f6f6f4",
   "ink": "#14180f",
   "navy": "#051c2c",
   "navy-soft": "#0b2a3d",
   "blue": "#2251ff",
   "cyan": "#00a9f4",
   "blue-web": "#3987e5",
   "steel": "#8fa3b5",
   "mist": "#c9d3da",
   "panel-1": "#f4f7fb",
   "panel-2": "#eef2f6",
   "pos": "#0a5a2d",
   "neg": "#a5402c",
   "warn": "#c0392b",
   "info": "#0a2d5a"
  },
  "type": {
   "font-serif": "Georgia,'Times New Roman',serif",
   "font-sans": "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif",
   "font-mono": "ui-monospace,SFMono-Regular,Menlo,Consolas,monospace",
   "font-body": "var(--font-serif)",
   "font-display": "var(--font-sans)",
   "step--2": "clamp(.70rem,.68rem + .10vw,.76rem)",
   "step--1": "clamp(.78rem,.75rem + .15vw,.85rem)",
   "step-0": "clamp(.92rem,.88rem + .20vw,1.00rem)",
   "step-1": "clamp(1.05rem,1.00rem + .30vw,1.20rem)",
   "step-2": "clamp(1.30rem,1.20rem + .50vw,1.60rem)",
   "step-3": "clamp(1.60rem,1.40rem + .90vw,2.10rem)",
   "step-4": "clamp(2.00rem,1.70rem + 1.40vw,2.90rem)"
  },
  "space": {
   "sp-1": ".25rem",
   "sp-2": ".5rem",
   "sp-3": ".75rem",
   "sp-4": "1rem",
   "sp-5": "1.5rem",
   "sp-6": "2rem",
   "sp-7": "3rem",
   "sp-8": "4rem",
   "radius": "12px",
   "radius-sm": "8px",
   "radius-pill": "999px",
   "shadow-1": "0 1px 2px rgba(0,0,0,.04)",
   "shadow-2": "0 2px 8px rgba(0,0,0,.06)"
  },
  "layout": {
   "measure": "68ch",
   "wrap": "1040px",
   "wrap-wide": "1320px"
  },
  "semantic": {
   "c-bg": "#fff",
   "c-surface": "var(--gray-0)",
   "c-surface-2": "var(--gray-1)",
   "c-border": "var(--gray-3)",
   "c-text": "var(--gray-9)",
   "c-text-mut": "var(--gray-6)",
   "c-accent": "var(--teal-deep)",
   "c-accent-soft": "var(--teal-mid)",
   "c-on-accent": "#fff",
   "c-rule": "var(--gray-9)",
   "c-pos": "var(--pos)",
   "c-neg": "var(--neg)"
  },
  "other": {}
 }
}